---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Portfolio",
  description = "A static portfolio built with Astro."
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="lerishia">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%2312181b'/%3E%3Cpath d='M24 72V28h17c16 0 25 8 25 22s-9 22-25 22H24Zm12-10h5c8 0 13-4 13-12s-5-12-13-12h-5v24Z' fill='%23f4efe7'/%3E%3C/svg%3E" />
    <title>{title}</title>
  </head>
  <body class="bg-base-100 text-base-content">
    <slot />
  </body>
</html>
