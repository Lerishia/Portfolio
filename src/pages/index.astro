---
import PortfolioGallery from "../components/PortfolioGallery.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { portfolioSections } from "../data/portfolio";
import { site, specialties } from "../data/site";

const videoShowcase = [
  {
    title: "Corporate Campaign Video",
    src: "/portfolio-images/Corporate%20Material/Corporate%20campaign%20video.mp4"
  },
  {
    title: "Personal Motion Study 01",
    src: "/portfolio-images/Personal%20projects/20%20-%20Comp%201.mp4"
  },
  {
    title: "Personal Motion Study 02",
    src: "/portfolio-images/Personal%20projects/21%20-%20Comp%201_1.mp4"
  }
];
---

<MainLayout title={`${site.name} | Portfolio`} description="Portfolio website for Lerishia Naidoo.">
  <div class="site-nav-wrap">
    <header class="site-nav" data-reveal>
      <div class="site-nav-shell">
        <a class="site-nav-brand" href="#home">{site.name}</a>
        <div class="site-nav-links">
          <nav>
            <ul class="menu menu-horizontal site-nav-menu">
              <li><a href="#home">Home</a></li>
              <li><a href="#about">About</a></li>
              <li><a href="#portfolio">Projects</a></li>
              <li><a href="#videos">Video</a></li>
            </ul>
          </nav>
          <a class="btn site-nav-cta" href="#contact">
            Get in touch →
          </a>
        </div>
      </div>
    </header>
  </div>

  <main class="site-main py-0">
      <section class="overflow-hidden" id="home">
        <div class="hero-glow hero-stage page-gutter relative overflow-hidden pb-6 pt-5 md:pt-6">
          <div class="hero-frosted-image absolute inset-0 z-0" style={`background-image: url(${site.profileImage});`}></div>
          <div class="hero-image-fade absolute inset-0"></div>
          <div class="hero-vignette absolute inset-0"></div>

          <div class="relative z-10 flex min-h-[calc(100vh-3rem)] flex-col">
            <div class="hero-copy-shell grid min-h-[58vh] flex-1 gap-10 pb-10 pt-28 md:pt-32 lg:grid-cols-[1fr] lg:items-center xl:min-h-[66vh]">
              <div class="space-y-5" data-reveal data-reveal-delay="0.05">
                <p class="text-2xl font-semibold text-white/95 md:text-3xl">Hey, I'm Lerishia</p>
                <h1 class="font-display max-w-[7ch] text-6xl font-black leading-[0.9] text-white sm:text-7xl xl:text-[7.2rem]">
                  Digital
                  <br />
                  Designer
                </h1>
              </div>
            </div>
          </div>

        </div>
      </section>

      <section class="page-gutter py-14 md:py-18" id="about">
        <div class="about-panel about-panel-grid" data-reveal>
          <div class="about-intro">
            <p class="eyebrow mb-4">About Lerishia</p>
            <h2 class="font-display about-title">
              Digital Design With A Growing Focus On Web And UI/UX
            </h2>
            <p class="about-summary text-white">
              I create digital work that balances visual clarity, usability, and strong brand communication.
            </p>
          </div>

          <div class="about-copy">
            <p class="dark-copy text-base leading-8">
              {site.about}
            </p>
            <p class="dark-copy text-base leading-8">
              I use AI for ideation, exploration, production support, and workflow efficiency while keeping strategy,
              design thinking, and final creative judgment at the center of the work.
            </p>
            <div class="about-tag-row">
              {
                specialties.map((item) => (
                  <span class="about-tag">{item.title}</span>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <PortfolioGallery sections={portfolioSections} />

      <section class="page-gutter py-14 md:py-18" id="videos">
        <div class="space-y-6" data-reveal>
          <div class="max-w-none">
            <p class="eyebrow mb-4">Video Work</p>
            <h2 class="font-display max-w-none text-5xl font-black uppercase leading-[0.95] text-white sm:text-6xl">
              Motion And Video Highlights
            </h2>
            <p class="mt-5 max-w-[56rem] text-base leading-8 text-white/68">
              A selection of motion pieces, campaign video work, and moving visual content that sits alongside the rest
              of the portfolio.
            </p>
          </div>

          <div class="video-grid">
            {
              videoShowcase.map((video) => (
                <article class="video-card glass-panel" data-reveal>
                  <video class="video-frame" controls preload="metadata">
                    <source src={video.src} type="video/mp4" />
                    Your browser does not support the video tag.
                  </video>
                  <div class="video-card-copy">
                    <p class="video-card-title">{video.title}</p>
                  </div>
                </article>
              ))
            }
          </div>

          <div class="video-embed-card glass-panel" data-reveal data-reveal-delay="0.12">
            <div class="video-embed-shell">
              <iframe
                width="560"
                height="315"
                src="https://www.youtube.com/embed/8YYJyQY_tbE?si=wZDjMu0bOoPIjMrS"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <section class="page-gutter py-14 md:py-18" id="contact">
        <div class="contact-section-grid">
          <div class="about-panel contact-panel-copy" data-reveal>
            <p class="eyebrow mb-4">Contact Me</p>
            <h2 class="font-display contact-panel-title">
              Let’s Build Better Digital Experiences
            </h2>
            <p class="contact-panel-summary text-white">
              If you need support with digital design, web design, UI/UX, or AI-supported creative workflows, I’d love
              to hear about your project.
            </p>

            <div class="contact-link-stack">
              <a class="contact-link-card" href={`mailto:${site.email}`}>
                <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Email</p>
                <p class="mt-2 text-base font-medium text-white">{site.email}</p>
              </a>
              <a class="contact-link-card" href={`tel:${site.phone.replace(/\s+/g, "")}`}>
                <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Phone</p>
                <p class="mt-2 text-base font-medium text-white">{site.phone}</p>
              </a>
              <a class="contact-link-card" href="/files/Lerishia-Naidoo-CV.pdf" download>
                <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Download CV</p>
                <p class="mt-2 text-base font-medium text-white">Lerishia Naidoo CV.pdf</p>
              </a>
            </div>
          </div>

          <div class="about-panel contact-panel-services" data-reveal data-reveal-delay="0.12">
            <p class="eyebrow mb-4">What I Do</p>
            <div class="contact-service-grid">
              <article class="contact-service-card">
                <h3 class="font-display text-2xl font-black uppercase text-white">Digital Design</h3>
                <p class="mt-3 text-base leading-7 text-white/72">
                  Brand-led campaign visuals, polished layouts, and digital assets built for clarity and consistency.
                </p>
              </article>
              <article class="contact-service-card">
                <h3 class="font-display text-2xl font-black uppercase text-white">Web Design</h3>
                <p class="mt-3 text-base leading-7 text-white/72">
                  Responsive web design shaped by structure, usability, and strong visual storytelling.
                </p>
              </article>
              <article class="contact-service-card">
                <h3 class="font-display text-2xl font-black uppercase text-white">UI/UX Design</h3>
                <p class="mt-3 text-base leading-7 text-white/72">
                  Interface thinking, user journeys, and digital systems that make experiences easier to use.
                </p>
              </article>
              <article class="contact-service-card">
                <h3 class="font-display text-2xl font-black uppercase text-white">AI Assisted Workflows</h3>
                <p class="mt-3 text-base leading-7 text-white/72">
                  AI-supported ideation and production workflows used thoughtfully to improve speed and exploration.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>
  </main>
</MainLayout>
